<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:name=".MediaPlayerApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Base.Theme.YzlVideo"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".ui.videodetail.VideoDetailActivity"
            android:launchMode="singleTask"
            android:exported="false" />

        <activity android:name=".ui.comment.VideoCommentFragment"
            android:exported="false"/>

        <activity android:name=".ui.introduce.IntroduceFragment"
            android:exported="false"/>

        <activity android:name=".ui.videolist.VideoListFragment"
            android:exported="false"/>
        <activity android:name=".ui.categorylist.CategoryListFragment"
            android:exported="false"/>
        <activity
            android:name=".ui.search.SearchActivity"
            android:exported="false"
            android:windowSoftInputMode="stateVisible|adjustResize" />
        <activity android:name=".ui.playerecord.PlayerRecordActivity"
            android:exported="false"/>
        <meta-data
            android:name="design_width_in_dp"
            android:value="375" />
        <meta-data
            android:name="design_height_in_dp"
            android:value="832" />

    </application>

</manifest>